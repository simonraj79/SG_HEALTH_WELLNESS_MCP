# Render supplies PORT automatically. Local default: 3000.
PORT=3000
HOST=0.0.0.0

# Optional data.gov.sg API key for higher upstream quotas.
DATA_GOV_SG_API_KEY=

# Optional bearer token protecting POST /mcp. Leave empty for public anonymous access.
MCP_API_KEY=

# Comma-separated hostnames only (no scheme or port). Render's hostname is allowed automatically.
ALLOWED_HOSTS=
# Browser caller hostnames only (no scheme or port). Non-browser MCP clients usually omit Origin.
ALLOWED_ORIGINS=

HTTP_RATE_LIMIT_PER_MINUTE=60
UPSTREAM_TIMEOUT_MS=10000
