{
  "name": "singapore-health-wellness-mcp-server",
  "version": "1.0.0",
  "description": "Public MCP server for curated Singapore health and wellness data from data.gov.sg",
  "type": "module",
  "main": "dist/src/http.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/http.ts",
    "start": "node dist/src/http.js",
    "start:stdio": "node --env-file=.env dist/src/stdio.js",
    "test": "node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:local-mcp": "node dist/scripts/local-stdio-smoke.js",
    "test:live": "node dist/scripts/live-smoke.js",
    "verify": "npm run clean && npm run build && npm test && npm run test:live"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
